DATABASE_URL="postgresql://nomadplan:nomadplan_dev@localhost:5432/nomadplan?schema=public"
PORT=3333
FRONTEND_URL="http://localhost:5173"
# Assina os tokens de login e de redefinição de senha: quem o conhece forja token de
# qualquer conta. Em produção (NODE_ENV=production) a API recusa iniciar com valor
# curto (< 32 caracteres) ou de exemplo. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="1d"
# Número de proxies confiáveis à frente da API (Nginx, load balancer). Deixe em
# branco em desenvolvimento local; em produção atrás de 1 proxy, use 1.
TRUST_PROXY=

# --- E-mail (recuperação de senha) ---
# O sistema envia o link de redefinição para o e-mail de cada usuário. Para isso precisa
# de UMA conta de envio (remetente), configurada aqui. Passo a passo no README.
# Sem SMTP_HOST, em desenvolvimento o link só aparece no console do backend; em
# produção nenhum e-mail é enviado.
# Exemplo com Gmail: ative a verificação em duas etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords. Teste com: npm run email:testar -- voce@gmail.com
SMTP_HOST=
SMTP_PORT=587
# "true" para TLS direto (porta 465); deixe em branco para o padrão da porta.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remetente exibido no e-mail. Se vazio, usa "NomadPlan <SMTP_USER>".
EMAIL_FROM=
# Caixa de entrada de teste local (Mailpit, docker-compose): SMTP_HOST="localhost" SMTP_PORT=1025

# --- Segurança e operação ---
# Chave que cifra o segredo da verificação em duas etapas (2FA) no banco. Se vazia, usa o
# JWT_SECRET. Em produção defina uma própria e guarde-a com o mesmo cuidado: sem ela, quem
# ativou o 2FA não consegue mais entrar. Gere como o JWT_SECRET.
CHAVE_CRIPTOGRAFIA=
# Tempo máximo (ms) de uma busca de pontos antes de responder com o último resultado em
# cache (marcado como desatualizado) ou com erro 504 (AF02). Padrão: 5000.
BUSCA_TIMEOUT_MS=5000
# De quanto em quanto tempo (ms) as métricas de uso agregadas são gravadas no banco. Padrão: 5000.
METRICAS_INTERVALO_MS=5000
# Pasta das imagens enviadas. Padrão: backend/uploads. Em produção, aponte para um volume
# que entre no backup (veja scripts/backup.sh).
UPLOADS_DIR=

# --- Testes (não use em produção) ---
# Banco dos testes de integração e dos testes de ponta a ponta. Se vazios, são derivados do
# DATABASE_URL com o sufixo _teste / _e2e e criados automaticamente.
TEST_DATABASE_URL=
E2E_DATABASE_URL=
