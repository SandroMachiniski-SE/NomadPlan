DATABASE_URL="postgresql://nomadplan:nomadplan_dev@localhost:5432/nomadplan?schema=public"
PORT=3333
FRONTEND_URL="http://localhost:5173"
# Assina os tokens de login e de redefinição de senha: quem o conhece forja token de
# qualquer conta. Em produção (NODE_ENV=production) a API recusa iniciar com valor
# curto (< 32 caracteres) ou de exemplo. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="7d"
# Número de proxies confiáveis à frente da API (Nginx, load balancer). Deixe em
# branco em desenvolvimento local; em produção atrás de 1 proxy, use 1.
TRUST_PROXY=
