{
  "name": "nomadplan-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "test": "npm run test:unit && npm run test:integracao",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:preparar": "tsx src/scripts/prepararBancoTeste.ts",
    "test:integracao": "npm run test:preparar && tsx --test --test-concurrency=1 \"src/**/*.itest.ts\"",
    "test:cobertura": "npm run test:preparar && tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/**/*.itest.ts\" --test-coverage-exclude=\"src/testes/**\" --test-coverage-exclude=\"src/scripts/**\" --test-coverage-lines=60 \"src/**/*.test.ts\" \"src/**/*.itest.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "e2e:preparar": "tsx src/scripts/prepararE2e.ts",
    "email:testar": "tsx src/scripts/testarEmail.ts",
    "osm:baixar": "tsx src/scripts/baixarOsm.ts",
    "osm:importar": "tsx src/scripts/importarOsm.ts",
    "overture:importar": "tsx src/scripts/importarOverture.ts",
    "curadoria:aplicar": "tsx src/scripts/aplicarCuradoria.ts",
    "roteiro:exemplo": "tsx src/scripts/criarRoteiroExemplo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
