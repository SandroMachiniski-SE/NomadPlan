generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoConta {
  VISITANTE
  MORADOR
  NEGOCIO
  GESTOR
  MODERADOR
  ADMIN
}

enum StatusPonto {
  RASCUNHO
  PUBLICADO
  PENDENTE_VERIFICACAO
  REJEITADO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
}

model Usuario {
  id          Int       @id @default(autoincrement())
  nome        String
  email       String    @unique
  senhaHash   String    @map("senha_hash")
  tipoConta   TipoConta @default(VISITANTE) @map("tipo_conta")
  cidadeBase  String?   @map("cidade_base")
  interesses  String[]  @default([])
  reputacao   Int       @default(0)
  ativo       Boolean   @default(true)
  dataCriacao DateTime  @default(now()) @map("data_criacao")

  // LGPD: quando o usuário aceitou a política de privacidade e quando a conta foi
  // anonimizada (a linha é mantida, sem dados pessoais, para preservar o histórico).
  consentimentoEm DateTime? @map("consentimento_em")
  removidoEm      DateTime? @map("removido_em")

  // Preferências do perfil (RF03).
  idioma                     String   @default("pt-BR")
  preferenciasAcessibilidade String[] @default([]) @map("preferencias_acessibilidade")

  // Autenticação em dois fatores por TOTP (RF21).
  mfaSegredo String? @map("mfa_segredo")
  mfaAtivo   Boolean @default(false) @map("mfa_ativo")

  pontosResponsaveis  PontoTuristico[]
  roteiros            Roteiro[]
  sugestoesEdicao     SugestaoEdicao[]         @relation("autorSugestao")
  verificacoesPedidas SolicitacaoVerificacao[] @relation("solicitanteVerificacao")
  avaliacoes          Avaliacao[]
  notificacoes        Notificacao[]
  logsAuditoria       LogAuditoria[]
  pontosSalvos        PontoSalvo[]

  @@map("usuario")
}

model PontoTuristico {
  id                   Int         @id @default(autoincrement())
  nome                 String
  descricao            String?
  categoria            String
  cidade               String
  endereco             String?
  latitude             Float?
  longitude            Float?
  faixaPreco           String?     @map("faixa_preco")
  acessibilidade       String?
  siteOficial          String?     @map("site_oficial")
  telefoneContato      String?     @map("telefone_contato")
  horarioFuncionamento String?     @map("horario_funcionamento")
  imagemUrl            String?     @map("imagem_url")
  status               StatusPonto @default(RASCUNHO)
  seloVerificado       Boolean     @default(false) @map("selo_verificado")
  motivoRejeicao       String?     @map("motivo_rejeicao")
  versao               Int         @default(1)
  dataCriacao          DateTime    @default(now()) @map("data_criacao")
  dataAtualizacao      DateTime    @updatedAt @map("data_atualizacao")
  idResponsavel        Int?        @map("id_responsavel")

  // Coluna geográfica (PostGIS), gerada pelo Postgres a partir de latitude/longitude —
  // ver migration modulo3_geom_indice_geografico. O Prisma não modela colunas
  // "GENERATED ALWAYS AS ... STORED", então toda vez que o schema muda, `prisma migrate
  // dev --create-only` tenta "corrigir" o índice/coluna; revisar e remover essa parte do
  // SQL gerado antes de aplicar (nunca aceitar um DROP COLUMN "geom" automático).
  geom Unsupported("geography(Point,4326)")?
  responsavel  Usuario?                 @relation(fields: [idResponsavel], references: [id])
  itensRoteiro ItemRoteiro[]
  sugestoes    SugestaoEdicao[]
  verificacoes SolicitacaoVerificacao[]
  avaliacoes   Avaliacao[]
  versoes      VersaoPonto[]
  salvosPor    PontoSalvo[]

  @@index([cidade])
  @@index([categoria])
  @@index([status])
  @@map("ponto_turistico")
}

model Avaliacao {
  id             Int               @id @default(autoincrement())
  idPonto        Int               @map("id_ponto")
  idAutor        Int               @map("id_autor")
  nota           Int
  comentario     String?
  fotoUrl        String?           @map("foto_url")
  status         StatusSolicitacao @default(PENDENTE)
  motivoRejeicao String?           @map("motivo_rejeicao")
  motivoRetencao String?           @map("motivo_retencao")
  dataCriacao    DateTime          @default(now()) @map("data_criacao")

  ponto PontoTuristico @relation(fields: [idPonto], references: [id], onDelete: Cascade)
  autor Usuario        @relation(fields: [idAutor], references: [id])

  @@unique([idPonto, idAutor])
  @@index([idPonto])
  @@index([idAutor])
  @@index([status])
  @@map("avaliacao")
}

model VersaoPonto {
  id          Int      @id @default(autoincrement())
  idPonto     Int      @map("id_ponto")
  dados       Json
  idAutor     Int?     @map("id_autor")
  motivo      String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  ponto PontoTuristico @relation(fields: [idPonto], references: [id], onDelete: Cascade)

  @@index([idPonto])
  @@map("versao_ponto")
}

model Notificacao {
  id          Int      @id @default(autoincrement())
  idUsuario   Int      @map("id_usuario")
  mensagem    String
  link        String?
  lida        Boolean  @default(false)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("notificacao")
}

model LogAuditoria {
  id          Int      @id @default(autoincrement())
  idUsuario   Int?     @map("id_usuario")
  acao        String
  entidade    String
  idEntidade  Int?     @map("id_entidade")
  detalhes    Json?
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario? @relation(fields: [idUsuario], references: [id])

  @@index([entidade, idEntidade])
  @@index([dataCriacao])
  @@index([idUsuario])
  @@map("log_auditoria")
}

model SugestaoEdicao {
  id              Int               @id @default(autoincrement())
  idPonto         Int               @map("id_ponto")
  idAutor         Int               @map("id_autor")
  camposPropostos Json              @map("campos_propostos")
  mensagem        String?
  status          StatusSolicitacao @default(PENDENTE)
  idModerador     Int?              @map("id_moderador")
  motivoRejeicao  String?           @map("motivo_rejeicao")
  motivoRetencao  String?           @map("motivo_retencao")
  dataCriacao     DateTime          @default(now()) @map("data_criacao")
  dataResolucao   DateTime?         @map("data_resolucao")

  ponto PontoTuristico @relation(fields: [idPonto], references: [id], onDelete: Cascade)
  autor Usuario        @relation("autorSugestao", fields: [idAutor], references: [id])

  @@index([idPonto])
  @@index([status])
  @@map("sugestao_edicao")
}

model SolicitacaoVerificacao {
  id             Int               @id @default(autoincrement())
  idPonto        Int               @map("id_ponto")
  idSolicitante  Int               @map("id_solicitante")
  comprovacao    String?
  status         StatusSolicitacao @default(PENDENTE)
  idModerador    Int?              @map("id_moderador")
  motivoRejeicao String?           @map("motivo_rejeicao")
  dataCriacao    DateTime          @default(now()) @map("data_criacao")
  dataResolucao  DateTime?         @map("data_resolucao")

  ponto       PontoTuristico @relation(fields: [idPonto], references: [id], onDelete: Cascade)
  solicitante Usuario        @relation("solicitanteVerificacao", fields: [idSolicitante], references: [id])

  @@index([idPonto])
  @@index([status])
  @@map("solicitacao_verificacao")
}

model Roteiro {
  id              Int       @id @default(autoincrement())
  nome            String
  descricao       String?
  cidade          String?
  dataInicio      DateTime? @map("data_inicio")
  dataFim         DateTime? @map("data_fim")
  idUsuario       Int       @map("id_usuario")
  publico         Boolean   @default(false)
  slugPublico     String?   @unique @map("slug_publico")

  // Anotações livres e teto de gastos da viagem (em centavos). Ficam só para o dono.
  notas              String?
  orcamentoCentavos  Int?      @map("orcamento_centavos")

  dataCriacao     DateTime  @default(now()) @map("data_criacao")
  dataAtualizacao DateTime  @updatedAt @map("data_atualizacao")

  usuario Usuario         @relation(fields: [idUsuario], references: [id])
  itens   ItemRoteiro[]
  versoes   VersaoRoteiro[]
  checklist ItemChecklist[]

  @@index([idUsuario])
  @@map("roteiro")
}

model ItemRoteiro {
  id          Int      @id @default(autoincrement())
  idRoteiro   Int      @map("id_roteiro")
  idPonto     Int      @map("id_ponto")
  // Dia do roteiro (1, 2, 3...) em que a parada acontece; a ordem vale dentro de cada dia.
  dia         Int      @default(1)
  ordem       Int      @default(0)
  observacao  String?
  // Quanto se pretende gastar nesta parada, em centavos (entrada, refeição...).
  custoCentavos Int?     @map("custo_centavos")
  dataCriacao DateTime @default(now()) @map("data_criacao")

  roteiro Roteiro        @relation(fields: [idRoteiro], references: [id], onDelete: Cascade)
  ponto   PontoTuristico @relation(fields: [idPonto], references: [id])

  @@unique([idRoteiro, idPonto])
  @@index([idRoteiro])
  @@map("item_roteiro")
}

model PontoSalvo {
  id          Int      @id @default(autoincrement())
  idUsuario   Int      @map("id_usuario")
  idPonto     Int      @map("id_ponto")
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario        @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  ponto   PontoTuristico @relation(fields: [idPonto], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idPonto])
  @@index([idUsuario])
  @@map("ponto_salvo")
}

model VersaoRoteiro {
  id          Int      @id @default(autoincrement())
  idRoteiro   Int      @map("id_roteiro")
  dados       Json
  idAutor     Int?     @map("id_autor")
  motivo      String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  roteiro Roteiro @relation(fields: [idRoteiro], references: [id], onDelete: Cascade)

  @@index([idRoteiro])
  @@map("versao_roteiro")
}

model MetricaDiaria {
  dia   DateTime @db.Date
  tipo  String
  total Int      @default(0)

  @@id([dia, tipo])
  @@map("metrica_diaria")
}

model ItemChecklist {
  id          Int      @id @default(autoincrement())
  idRoteiro   Int      @map("id_roteiro")
  texto       String
  feito       Boolean  @default(false)
  ordem       Int      @default(0)
  dataCriacao DateTime @default(now()) @map("data_criacao")

  roteiro Roteiro @relation(fields: [idRoteiro], references: [id], onDelete: Cascade)

  @@index([idRoteiro])
  @@map("item_checklist")
}
