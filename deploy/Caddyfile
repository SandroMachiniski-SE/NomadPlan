# Dois endereços: o site (arquivos estáticos) e a API (proxy para o contêiner "api").
# O Caddy obtém e renova os certificados HTTPS sozinho, desde que o DNS aponte para este servidor.

{$DOMINIO_WEB} {
	root * /srv
	encode zstd gzip
	# Aplicação de página única: qualquer rota desconhecida devolve o index.html.
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# O link de redefinição de senha leva um token na URL: o Referrer-Policy impede que
		# ele vá parar em outros sites (mapas, fotos) pelo cabeçalho Referer.
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# Restrições que não afetam o site: sem embutir em outras páginas, sem plugins,
		# sem trocar o endereço-base dos links.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}
}

{$DOMINIO_API} {
	encode zstd gzip
	reverse_proxy api:3333
}
