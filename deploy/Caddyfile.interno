# Variante para quando OUTRO Caddy (ou proxy) já ocupa as portas 80 e 443 do servidor.
# Aqui o site é servido só em HTTP, dentro da rede do Docker, sem publicar porta nenhuma:
# o HTTPS e os certificados ficam com o proxy existente (veja docs/implantacao-vps-compartilhada.md).
{
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	# Aplicação de página única: qualquer rota desconhecida devolve o index.html.
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		# Política completa em modo só-relatório: o navegador avisa no console sobre o que ela bloquearia,
		# mas não bloqueia nada. Depois de navegar pelo site sem avisos (mapa, foto, roteiro, perfil), troque
		# o nome do cabeçalho por Content-Security-Policy (docs/seguranca.md, "Riscos aceitos").
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://upload.wikimedia.org https://commons.wikimedia.org https://{$DOMINIO_API} https://*.googleusercontent.com https://places.googleapis.com; connect-src 'self' https://{$DOMINIO_API}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}
}
