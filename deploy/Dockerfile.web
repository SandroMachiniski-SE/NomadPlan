# Frontend do NomadPlan + Caddy (HTTPS automático e proxy da API). Contexto de build: a raiz do repositório.
FROM node:22-slim AS construcao
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
# A URL da API é fixada na compilação.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=construcao /app/dist /srv
