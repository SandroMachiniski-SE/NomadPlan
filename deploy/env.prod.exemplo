# Copie para .env.prod (na raiz do projeto, no servidor) e preencha. NUNCA coloque o .env.prod no git.

# Endereços públicos (sem https://). Os dois precisam apontar para o IP do servidor no DNS.
DOMINIO_WEB=nomadplan.blackyears.com.br
DOMINIO_API=api.nomadplan.blackyears.com.br

# Gere cada segredo com:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
CHAVE_CRIPTOGRAFIA=

# E-mail (recuperação de senha e convites) pelo Brevo. Deixe SMTP_HOST vazio para não enviar e-mails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NomadPlan <nao-responda@blackyears.com.br>"
# "true" para TLS direto (porta 465); vazio usa o padrão da porta.
SMTP_SECURE=

# --- Opcionais: deixe vazio para usar o padrão. Depois de mudar, rode de novo o "up -d" da API. ---
# Google Places API (New): nota, horário e foto do Google Maps na página do ponto, e horário dos
# pontos que não têm no gerador de roteiros. Crie em https://console.cloud.google.com, restrita
# à "Places API (New)".
GOOGLE_MAPS_API_KEY=
# Quantos pontos sem horário o gerador consulta no Google por roteiro (cada um conta na cota). Padrão: 8.
GOOGLE_PONTOS_POR_ROTEIRO=
# Servidores públicos do OpenStreetMap: rotas de carro (OSRM), preparo de cidades (Overpass) e
# busca de endereços (Nominatim). Troque só se o padrão estiver fora do ar ou lento.
# Ex.: OSRM_URL=https://routing.openstreetmap.de/routed-car
#      OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
OSRM_URL=
OVERPASS_URL=
NOMINATIM_URL=
